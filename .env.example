# ─── Server ───────────────────────────────────────────────────────────────────

# Port the Express API listens on
PORT=6767

# Prisma Postgres connection string
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_PRISMA_API_KEY"

# Redis (Upstash or self-hosted) — used by BullMQ for job queues
REDIS_URL="rediss://default:YOUR_PASSWORD@your-host.upstash.io:6379"

# ─── Auth ─────────────────────────────────────────────────────────────────────

# Better-Auth base URL (the API origin, not the frontend)
BETTER_AUTH_URL="http://localhost:6767"

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
# Set to true only if using port 465
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
# Gmail: use an App Password, not your account password
SMTP_PASS="your-app-password"

# Master email — receives a copy of every notification and system report
MASTER_EMAIL="admin@example.com"
# Alias for MASTER_EMAIL (either works)
# ADMIN_EMAIL="admin@example.com"

# ─── App URLs ─────────────────────────────────────────────────────────────────

# The frontend origin — used in email links and CORS trusted origins
FRONTEND_URL="http://localhost:3000"

# ─── Logging ──────────────────────────────────────────────────────────────────

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
